{
  "name": "dsh-ai-mind",
  "version": "0.1.9",
  "description": "AI 心流：右侧实时显示 AI 正在做什么、当前思路、任务进度、思路导图与任务导图",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "dsh-better-sidebar"
      ],
      "immediately": true
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.cjs",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "fnos",
    "飞牛",
    "sidebar",
    "mindmap",
    "ai-mind"
  ],
  "peerDependencies": {
    "dsh-better-sidebar": ">=0.26.0"
  },
  "peerDependenciesMeta": {
    "dsh-better-sidebar": {
      "optional": true
    }
  },
  "author": "CyberZero"
}
